@using KikoleSite.Helpers
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model UserDayModel

<div class="kikole-board">
    <div class="form-card">
        <h2 class="profile-name">@Model.UserLogin</h2>
        <div class="form-hint" style="margin:-4px 0 16px">@localizer["PlayerOf"] <span class="greentext">@Model.ProposalDate.ToNaString()</span></div>
        <div class="form-field">
            <label>@localizer["PlayerToFind"]</label>
            <div class="form-static">@Model.PlayerName</div>
        </div>
        <div class="form-field">
            <label>@localizer["FinalScore"]</label>
            <div class="form-static">@Model.UserScore</div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="tabDataHead">@localizer["Date"]</th>
                        <th class="tabDataHead">@localizer["Type"]</th>
                        <th class="tabDataHead">@localizer["Value"]</th>
                        <th class="tabDataHead">@localizer["IsSuccess"]</th>
                        <th class="tabDataHead">@localizer["LostPoints"]</th>
                        <th class="tabDataHead">@localizer["RemainingPoints"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.ProposalDetails)
                    {
                        var tdSucessClass = item.Success ? "fillCorrect" : "fillIncorrect";
                        var typeClass = $"fill{(int)item.Type}";
                        <tr>
                            <td class="tabData">@item.Date.ToStringHour()</td>
                            <td class="tabData @typeClass">@item.Type.GetSimpleLabel()</td>
                            <td class="tabData">@item.Value</td>
                            <td class="tabData @tdSucessClass">@item.Success.ToYesNo()</td>
                            <td class="tabData">@item.PointsLost</td>
                            <td class="tabData">@item.PointsRemaining</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
