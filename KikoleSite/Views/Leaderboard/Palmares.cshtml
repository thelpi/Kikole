@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model PalmaresModel

<div class="kikole-board">
    <div class="form-card">
        <h3>Palmarès par mois</h3>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="tabDataHead">Date</th>
                        <th class="tabDataHead">Premier</th>
                        <th class="tabDataHead">Deuxième</th>
                        <th class="tabDataHead">Troisième</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MonthlyPalmares.Count == 0)
                    {
                        <tr class="even">
                            <td colspan="4" class="tabData">Aucune donnée à afficher</td>
                        </tr>
                    }
                    else
                    {
                        var i = 0;
                        foreach (var (date, palmares) in Model.MonthlyPalmares)
                        {
                            var trClass = i % 2 == 0 ? "even" : "odd";
                            <tr class="@trClass">
                                <td class="tabData">@date.ToString("MMM yyyy")</td>
                                <td class="tabData medal-gold"><a href="/Leaderboard?userId=@palmares[0].playerId">@palmares[0].playerName</a></td>
                                <td class="tabData medal-silver"><a href="/Leaderboard?userId=@palmares[1].playerId">@palmares[1].playerName</a></td>
                                <td class="tabData medal-bronze"><a href="/Leaderboard?userId=@palmares[2].playerId">@palmares[2].playerName</a></td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-card">
        <h3>Palmarès total</h3>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th class="tabDataHead redtext">Joueur</th>
                        <th class="tabDataHead">Nb. 1er</th>
                        <th class="tabDataHead">Nb. 2ème</th>
                        <th class="tabDataHead">Nb. 3ème</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.GlobalPalmares.Count == 0)
                    {
                        <tr class="even">
                            <td colspan="4" class="tabData">Aucune donnée à afficher</td>
                        </tr>
                    }
                    else
                    {
                        var i = 0;
                        foreach (var (player, first, second, third) in Model.GlobalPalmares)
                        {
                            var trClass = i % 2 == 0 ? "even" : "odd";
                            <tr class="@trClass">
                                <td class="tabData redtext">@player</td>
                                <td class="tabData medal-gold">@first</td>
                                <td class="tabData medal-silver">@second</td>
                                <td class="tabData medal-bronze">@third</td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
