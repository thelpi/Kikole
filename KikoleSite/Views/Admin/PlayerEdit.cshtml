@model PlayerEditModel

<div class="kikole-board">
    @if (Model.Success == true)
    {
        <div class="banner success">Modifications OK</div>
    }
    else if (Model.Success == false)
    {
        <div class="banner error">@(string.IsNullOrWhiteSpace(Model.Message) ? "Erreur inconnue" : Model.Message)</div>
    }

    <div class="form-card">
        <form method="post" action="/Admin/PlayerEdit">
            @Html.HiddenFor(m => m.PlayerId)
            <div class="form-field">
                <label>Clue (EN)</label>
                @Html.TextBoxFor(m => m.ClueEn, new { @class = "blank" })
            </div>
            <div class="form-field">
                <label>Clue (FR)</label>
                @Html.TextBoxFor(m => m.ClueFr, new { @class = "blank" })
            </div>
            <div class="form-field">
                <label>Easy (EN)</label>
                @Html.TextBoxFor(m => m.EasyClueEn, new { @class = "blank" })
            </div>
            <div class="form-field">
                <label>Easy (FR)</label>
                @Html.TextBoxFor(m => m.EasyClueFr, new { @class = "blank" })
            </div>
            <div class="actions">
                <button type="submit">Save</button>
            </div>
        </form>
    </div>
</div>
