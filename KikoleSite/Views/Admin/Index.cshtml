@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model PlayerCreationModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="banner error">@Model.ErrorMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
    {
        <div class="banner success">@Model.InfoMessage</div>
    }

    <div class="form-card">
        <h3>@localizer[Model.PlayerId.HasValue ? "EditPlayerTitle" : "SubmitPlayerTitle"]</h3>
        @if (Model.PlayerId.HasValue)
        {
            <div class="small-link"><a asp-controller="Admin" asp-action="UpcomingPlayers">@localizer["BackToUpcomingPlayers"]</a></div>
        }
        <form method="post" action="@(Model.PlayerId.HasValue ? "/Admin/PlayerEdit" : "/Admin")">
            @if (Model.PlayerId.HasValue)
            {
                <input type="hidden" name="PlayerId" value="@Model.PlayerId" />
            }
            <div class="form-field">
                <label>@localizer["Name"]</label>
                <input type="text" name="Name" class="blank" value="@Model.Name" />
            </div>

            <div class="form-field">
                <label>@localizer["AlternativeNames"]</label>
                @{ var altNames = new[] { Model.AlternativeName0, Model.AlternativeName1, Model.AlternativeName2, Model.AlternativeName3, Model.AlternativeName4, Model.AlternativeName5, Model.AlternativeName6, Model.AlternativeName7, Model.AlternativeName8, Model.AlternativeName9 }; }
                @for (var i = 0; i < Math.Max(5, Array.FindLastIndex(altNames, n => !string.IsNullOrWhiteSpace(n)) + 1); i++)
                {
                    var name = $"AlternativeName{i}";
                    <input type="text" name="@name" class="blank" style="margin-bottom:6px" value="@altNames[i]" />
                }
                <div class="form-hint">
                    @localizer["AltNameTip1"]<br />
                    @localizer["AltNameTip2"]
                </div>
            </div>

            <div class="form-field">
                <label>@localizer["YearOfBirth"]</label>
                <input type="text" id="birthYearValue" name="YearOfBirth" class="blank" style="max-width:100px" value="@Model.YearOfBirth" />
            </div>

            <div class="form-field">
                <label>@localizer["Nationality"]</label>
                <input type="text" id="countryName" name="CountryName" class="blank" value="@Model.CountryName" />
                <input type="hidden" id="countryId" name="Country" value="@Model.Country" />
            </div>

            <div class="form-field">
                <label>@localizer["AlternativeNationality"]</label>
                <input type="text" id="alternativeCountryName" name="AlternativeCountryName" class="blank" value="@Model.AlternativeCountryName" />
                <input type="hidden" id="alternativeCountryId" name="AlternativeCountry" value="@Model.AlternativeCountry" />
                <div class="form-hint spaced">@localizer["TipAboutAlternativeNationality"]</div>
            </div>

            @if (Model.DisplayPlayerSubmissionLink)
            {
                <div class="form-field">
                    <label>@localizer["ClueEn"]</label>
                    <input type="text" name="ClueEn" class="blank clue-field" value="@Model.ClueEn" />
                </div>

                <div class="form-field">
                    <label>@localizer["ClueFr"]</label>
                    <input type="text" name="ClueFr" class="blank clue-field" value="@Model.ClueFr" />
                </div>

                <div class="form-field">
                    <label>@localizer["EasyClueEn"]</label>
                    <input type="text" name="EasyClueEn" class="blank clue-field" value="@Model.EasyClueEn" />
                </div>

                <div class="form-field">
                    <label>@localizer["EasyClueFr"]</label>
                    <input type="text" name="EasyClueFr" class="blank clue-field" value="@Model.EasyClueFr" />
                </div>

                @if (!Model.PlayerId.HasValue)
                {
                    <div class="form-field">
                        <label>@localizer["ForcePublicationDate"]</label>
                        <input type="date" name="PublicationDate" class="blank" value="@Model.PublicationDate" />
                        <div class="form-hint">@localizer["ForcePublicationDateHint"]</div>
                    </div>
                }
            }
            else
            {
                <div class="form-field">
                    <label>@localizer["Clue"]</label>
                    <input type="text" name="ClueEn" class="blank clue-field" data-media="image" value="@Model.ClueEn" />
                    <div class="form-hint">
                        @localizer["AcceptedLanguages"]<br />
                        @localizer["AdminOverrideClue"]
                    </div>
                </div>

                <div class="form-field">
                    <label>@localizer["EasyClue"]</label>
                    <input type="text" name="EasyClueEn" class="blank clue-field" data-media="image" value="@Model.EasyClueEn" />
                    <div class="form-hint">
                        @localizer["AcceptedLanguages"]<br />
                        @localizer["AdminOverrideClue"]
                    </div>
                </div>
            }

            <div class="form-field">
                <label>@localizer["Position"]</label>
                @Html.DropDownListFor(m => m.Position, Model.Positions, new { @class = "blank" })
            </div>

            <div class="form-field">
                <label>@localizer["AlternativePosition"]</label>
                @Html.DropDownListFor(m => m.AlternativePosition, Model.Positions, new { @class = "blank" })
                <div class="form-hint spaced">@localizer["TipAboutAlternativePosition"]</div>
            </div>

            <div class="form-field">
                <label>@localizer["ClubsCareer"]</label>
                <div class="form-hint">@localizer["ClubsTip1"]</div>
                @{
                    var clubIds = new[] { Model.Club0Id, Model.Club1Id, Model.Club2Id, Model.Club3Id, Model.Club4Id, Model.Club5Id, Model.Club6Id, Model.Club7Id, Model.Club8Id, Model.Club9Id, Model.Club10Id, Model.Club11Id, Model.Club12Id, Model.Club13Id, Model.Club14Id };
                    var clubNames = new[] { Model.Club0Name, Model.Club1Name, Model.Club2Name, Model.Club3Name, Model.Club4Name, Model.Club5Name, Model.Club6Name, Model.Club7Name, Model.Club8Name, Model.Club9Name, Model.Club10Name, Model.Club11Name, Model.Club12Name, Model.Club13Name, Model.Club14Name };
                }
                @for (var i = 0; i < 15; i++)
                {
                    var name = $"Club{i}";
                    var idName = $"Club{i}Id";
                    var loanChk = $"IsLoan{i}";
                    <div class="check-line club-line-input">
                        <input type="text" id="@name" name="@(name)Name" class="blank" value="@clubNames[i]" />
                        <input type="hidden" id="@idName" name="@idName" value="@clubIds[i]" />
                        <label class="check-label" for="@loanChk">@localizer["IsLoan"]</label>
                        @Html.CheckBox(loanChk)
                    </div>
                }
                <div class="form-hint">@localizer["ClubsTip2"]</div>
                <div class="small-link"><a href="/Admin/Club" target="_blank">@localizer["AddClubTab"]</a></div>
            </div>

            <div class="form-field">
                <div class="check-line">
                    <label class="check-label" for="@Html.IdFor(m => m.HideCreator)">@localizer["RemainsAnonymous"]</label>
                    @Html.CheckBoxFor(m => m.HideCreator)
                </div>
                <div class="form-hint spaced">@localizer["RemainsAnonymousTip"]</div>
            </div>

            <div class="actions">
                <button type="submit" name="submit-club">@localizer[Model.PlayerId.HasValue ? "SaveChanges" : "SubmitPlayerGo"]</button>
            </div>

            @if (!Model.PlayerId.HasValue)
            {
                <p class="form-hint" style="margin-top:14px">@Html.Raw(string.Format(localizer["NewChartLaius"].Value, KikoleSite.Models.ScoreCalculator.SubmissionPoints))</p>
            }
        </form>
    </div>
</div>
