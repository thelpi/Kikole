@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model ClubCreationModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="banner error">@Model.ErrorMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
    {
        <div class="banner success">@Model.InfoMessage</div>
    }

    <div class="form-card">
        <h3>@localizer[Model.Id > 0 ? "EditClubTitle" : "CreateClubTitle"]</h3>
        @if (Model.CanEditExisting)
        {
            <div class="form-field">
                <label for="clubEditSearch">@localizer[Model.Id > 0 ? "EditExistingClub" : "SearchExistingClub"]</label>
                <input type="text" id="clubEditSearch" class="blank" autocomplete="off" />
            </div>
        }
        <form method="post" action="/Admin/Club">
            @if (Model.Id == 0)
            {
                if (!Model.CanEditExisting)
                {
                    <div class="form-field">
                        <label>@localizer["SearchAlreadyExists"]</label>
                        <input type="text" name="dummyClub" id="clubName" class="blank" />
                    </div>
                }
            }
            else
            {
                <div class="form-hint">
                    @if (Model.PreviousClubId.HasValue)
                    {
                        <a href="/Admin/Club?clubId=@Model.PreviousClubId">@localizer["PreviousClub"]</a>
                    }
                    @if (Model.PreviousClubId.HasValue && Model.NextClubId.HasValue)
                    {
                        <span> - </span>
                    }
                    @if (Model.NextClubId.HasValue)
                    {
                        <a href="/Admin/Club?clubId=@Model.NextClubId">@localizer["NextClub"]</a>
                    }
                </div>
            }
            <div class="form-field">
                <label>@localizer["Country"]</label>
                <input type="text" id="countryName" name="CountryNameSubmissionValue" class="blank" value="@Model.CountryName" />
                <input type="hidden" id="countryId" name="Country" value="@Model.Country" />
            </div>
            <div class="form-field">
                <label>@localizer["MainNameFr"]</label>
                @Html.TextBoxFor(x => x.MainNameFr, null, new { @class = "blank" })
            </div>
            <div class="form-field">
                <label>@localizer["MainNameEn"]</label>
                @Html.TextBoxFor(x => x.MainNameEn, null, new { @class = "blank" })
            </div>
            <div class="form-field">
                <label>@localizer["AlternativeNamesFr"]</label>
                @Html.TextAreaFor(x => x.AlternativeNamesFr, 4, 30, new { @class = "blank" })
            </div>
            <div class="form-field">
                <label>@localizer["AlternativeNamesEn"]</label>
                @Html.TextAreaFor(x => x.AlternativeNamesEn, 4, 30, new { @class = "blank" })
            </div>
            <div class="form-hint">
                @localizer["MainNameHint"]<br />
                @localizer["AlternativeNamesHint"]<br />
                @localizer["AlternativeNamesExample"]
            </div>

            @Html.HiddenFor(x => x.Id)
            <div class="actions">
                <button type="submit" name="submit-club">@localizer[Model.Id > 0 ? "DoSave" : "DoCreate"]</button>
            </div>
        </form>
    </div>

    @if (Model.CanEditExisting && Model.Id > 0)
    {
        <div class="form-card">
            <h3>@localizer["DeleteClubTitle"]</h3>
            @if (Model.PlayerNames.Count > 0)
            {
                <p>@string.Format(localizer["ClubUsedBy"].Value, string.Join(", ", Model.PlayerNames) + (Model.PlayerNames.Count >= 20 ? "…" : ""))</p>
            }
            else if (Model.CorrectProposals > 0)
            {
                <p>@localizer["ClubUsedByProposals"]</p>
            }
            else
            {
                <p>@(Model.IncorrectProposals > 0 ? string.Format(localizer["ClubDeleteHintWithProposals"].Value, Model.IncorrectProposals) : localizer["ClubDeleteHint"].Value)</p>
                <div class="actions">
                    <button type="button" id="clubDeleteBtn">@localizer["DeleteClub"]</button>
                </div>
                <form method="post" action="/Admin/DeleteClub" id="clubDeleteForm" style="margin:0">
                    <input type="hidden" name="clubId" value="@Model.Id" />
                </form>
            }
        </div>

        @if (Model.CanDelete)
        {
            <div class="confirm-modal" id="clubDeleteModal" role="dialog" aria-modal="true" aria-labelledby="clubDeleteText">
                <div class="confirm-modal-box">
                    <p id="clubDeleteText">@string.Format(localizer[Model.IncorrectProposals > 0 ? "ClubDeleteConfirmWithProposals" : "ClubDeleteConfirm"].Value, Model.MainNameFr, Model.IncorrectProposals)</p>
                    <div class="confirm-modal-actions">
                        <button type="button" class="secondary" id="clubDeleteCancel">@localizer["Cancel"]</button>
                        <button type="submit" form="clubDeleteForm" id="clubDeleteConfirm">@localizer["Confirm"]</button>
                    </div>
                </div>
            </div>
        }
    }
</div>
