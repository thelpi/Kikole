@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model AdminModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model?.ActionFeedback))
    {
        <div class="banner success">@Model.ActionFeedback</div>
    }

    <div class="form-card">
        <h3>@localizer["AdminActions"]</h3>
        <div class="small-link"><a href="/Admin/PlayerSubmission">@localizer["CheckSubmittedPlayers"]</a></div>
        <div class="actions" style="margin-top:14px">
            <form method="post" action="/Admin/RecomputeBadges">
                <button type="submit">@localizer["RecomputeBadges"]</button>
            </form>
            <form method="post" action="/Admin/RecomputeLeaders">
                <button type="submit">@localizer["RecomputeLeaders"]</button>
            </form>
            <form method="post" action="/Admin/ReassignPlayers">
                <button type="submit">@localizer["ReassignPlayers"]</button>
            </form>
        </div>
    </div>

    <div class="form-card">
        <h3>@localizer["AddGlobalMessage"]</h3>
        <form method="post" action="/Admin/InsertMessage">
            <div class="form-field">
                <label>@localizer["MessageLabel"]</label>
                @Html.TextBoxFor(m => m.Message, new { @class = "blank" })
            </div>
            <div class="form-row">
                <div class="form-field">
                    <label>@localizer["MessageDateStartLabel"]</label>
                    @Html.EditorFor(m => m.MessageDateStart)
                </div>
                <div class="form-field">
                    <label>@localizer["MessageDateEndLabel"]</label>
                    @Html.EditorFor(m => m.MessageDateEnd)
                </div>
            </div>
            <div class="actions">
                <button type="submit">@localizer["ActionAddMessage"]</button>
            </div>
        </form>
    </div>

    @if (Model?.Discussions.Count > 0)
    {
        <div class="form-card">
            <h3>Discussions</h3>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th class="tabDataHead">User</th>
                            <th class="tabDataHead">Email</th>
                            <th class="tabDataHead">Date</th>
                            <th class="tabDataHead">Message</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var i = 0;
                        }
                        @foreach (var discussion in Model.Discussions)
                        {
                            var trClass = i % 2 == 0 ? "even" : "odd";
                            <tr class="@trClass">
                                <td class="tabData">@discussion.UserId</td>
                                <td class="tabData">@discussion.Email</td>
                                <td class="tabData">@discussion.CreationDate</td>
                                <td class="tabData">@Html.Raw(discussion.Message)</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
