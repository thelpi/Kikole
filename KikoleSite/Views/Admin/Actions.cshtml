@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model AdminModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model?.ActionFeedback))
    {
        <div class="banner success">@Model.ActionFeedback</div>
    }

    <div class="form-card">
        <h3>@localizer["AdminActions"]</h3>
        <div class="small-link"><a href="/Admin/PlayerSubmission">@localizer["CheckSubmittedPlayers"]</a></div>
        <div class="small-link"><a asp-controller="Admin" asp-action="Discussions">@localizer["ViewDiscussions"]</a></div>
        <div class="small-link"><a asp-controller="Admin" asp-action="UpcomingPlayers">@localizer["UpcomingPlayers"]</a></div>
        <div class="small-link"><a asp-controller="Admin" asp-action="Announcements">@localizer["ManageAnnouncements"]</a></div>
        <div class="small-link"><a asp-controller="Admin" asp-action="Users">@localizer["ManageUsers"]</a></div>
        <div class="small-link"><a asp-controller="Admin" asp-action="Errors">@localizer["ViewErrors"]</a></div>
        <div class="actions" style="margin-top:14px">
            <form method="post" action="/Admin/RecomputeBadges">
                <button type="submit">@localizer["RecomputeBadges"]</button>
            </form>
            <form method="post" action="/Admin/RecomputeLeaders">
                <button type="submit">@localizer["RecomputeLeaders"]</button>
            </form>
            <form method="post" action="/Admin/ReassignPlayers">
                <button type="submit">@localizer["ReassignPlayers"]</button>
            </form>
        </div>
    </div>
</div>
