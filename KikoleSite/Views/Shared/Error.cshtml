@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer

<div class="kikole-board">
    <div class="form-card">
        <h2 class="profile-name" style="color:var(--stamp)">@localizer["ErrorTitle"]</h2>
        <p>@localizer["ErrorMessage"]</p>
        <div class="actions">
            <a href="/Home">@localizer["BackToHome"]</a>
        </div>
    </div>
</div>
