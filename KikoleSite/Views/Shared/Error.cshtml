@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    // meme logique que _Layout.cshtml : la vue n'herite d'aucun controleur, on relit le
    // ClaimsPrincipal ambiant. Le lien vers le formulaire de contact n'a de sens que connecte.
    var userIdClaim = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isLoggedIn = ulong.TryParse(userIdClaim, out var currentUserId) && currentUserId > 0;
}

<div class="kikole-board">
    <div class="form-card">
        <h2 class="profile-name" style="color:var(--warn)">@localizer["ErrorTitle"]</h2>
        <p>@localizer["ErrorMessage"]</p>
        <p>@Html.Raw(isLoggedIn ? localizer["ErrorPersists"].Value : localizer["ErrorPersistsAnonymous"].Value)</p>
        <div class="actions">
            <a href="/Home">@localizer["BackToHome"]</a>
        </div>
    </div>
</div>
