@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@inject Microsoft.Extensions.Options.IOptions<KikoleSite.Configuration.SiteOptions> siteOptions
@{
    ViewData["Title"] = localizer["PageTitle"].Value;
    ViewData["Description"] = localizer["PageDescription"].Value;
}

<div class="kikole-board">
    <div class="form-card">
        <h2>@localizer["LegalTitle"]</h2>
        <h3>@localizer["PublisherTitle"]</h3>
        @Html.Raw(string.Format(localizer["PublisherBody"].Value, System.Net.WebUtility.HtmlEncode(siteOptions.Value.ContactEmail)))
    </div>

    <div class="form-card">
        <h3>@localizer["LiabilityTitle"]</h3>
        @localizer["LiabilityBody"]
    </div>

    <div class="form-card">
        <h3>@localizer["PrivacyTitle"]</h3>
        @Html.Raw(string.Format(localizer["PrivacyBody"].Value, System.Net.WebUtility.HtmlEncode(siteOptions.Value.ContactEmail)))
    </div>

    <div class="form-card">
        <h3>@localizer["CookiesTitle"]</h3>
        @localizer["CookiesBody"]
    </div>
</div>
