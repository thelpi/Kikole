@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer

<div class="kikole-board">
    <div class="form-card">
        <h2>@localizer["LegalTitle"]</h2>
        <h3>@localizer["PublisherTitle"]</h3>
        @localizer["PublisherBody"]
    </div>

    <div class="form-card">
        <h3>@localizer["LiabilityTitle"]</h3>
        @localizer["LiabilityBody"]
    </div>

    <div class="form-card">
        <h3>@localizer["PrivacyTitle"]</h3>
        @localizer["PrivacyBody"]
    </div>

    <div class="form-card">
        <h3>@localizer["CookiesTitle"]</h3>
        @localizer["CookiesBody"]
    </div>
</div>
