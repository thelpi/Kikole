@using KikoleSite.Helpers
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model HomeModel
<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.MessageToDisplay) && Model.IsErrorMessageForced)
    {
        <div class="banner error">@Model.MessageToDisplay</div>
    }
    @if (Model.DisplayHiddenPageAsHidden)
    {
        <div class="banner error">@localizer["AlmostThere"]</div>
    }
    else if (string.IsNullOrWhiteSpace(Model.LoggedAs))
    {
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="banner error">@Html.Raw(Model.Message)</div>
        }
        await Html.RenderPartialAsync("Partial/Rules");
        <div class="auth-notice">
            <p>@localizer["YouAreNotLogged"]</p>
            <p>@(Model.RegistrationInviteEnabled ? localizer["AccountMandatory"] : localizer["AccountMandatoryOpenRegistration"])</p>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="banner error">@Html.Raw(Model.Message)</div>
        }

        <div class="masthead">
            <div class="day-nav">
                @if (!Model.NoPreviousDay)
                {
                    <a href="/?day=@Model.PreviousDay">@localizer["PreviousDay"]</a>
                }
                <input type="text" id="dayDatepicker" class="date-field" readonly data-date="@Model.DateOfDay.ToString("yyyy-MM-dd")">
                @if (Model.CurrentDay > 0 || Model.IsAdmin)
                {
                    <a href="/?day=@Model.NextDay">@localizer["NextDay"]</a>
                }
                @if (Model.IsAdmin && Model.CurrentDay < 0)
                {
                    <a href="/Admin/PlayerEdit?playerId=@Model.PlayerId">@localizer["GoToPlayerClues"]</a>
                }
            </div>
            <div class="scoreboard">
                <div class="label">@localizer["Points"]</div>
                <div class="value">@Model.Points</div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.PlayerCreator))
        {
            <div class="creator-line">@Html.Raw(string.Format(localizer["SubmittedBy"].Value, Model.PlayerCreator))</div>
        }

        <div class="dossier">
        @if (!string.IsNullOrWhiteSpace(Model.PlayerName))
        {
            <div class="dossier-head">
                @if (Model.CurrentDay == 0 && !Model.IsCreator)
                {
                    <div class="banner success">@Html.Raw(string.Format(localizer["PlayerFoundCongrats"].Value, Model.PlayerName)) @localizer["ComeBackTomorrow"]</div>
                    <div class="creator-line">@Html.Raw(string.Format(localizer["FinalScore"].Value, Model.Points))</div>
                    await Html.RenderPartialAsync("Partial/Badges", Model.Badges);
                }
                else if (Model.CurrentDay == 0)
                {
                    <h1 style="margin:0">@localizer["PlayerIs"] <span style="color:var(--stamp)">@Model.PlayerName</span></h1>
                }
                else
                {
                    <h1 style="margin:0">@Html.Raw(string.Format(localizer["PlayerWas"].Value, Model.PlayerName, Model.DateOfDay.ToNaString()))</h1>
                }
                @if (Model.IsAdmin)
                {
                    <div class="creator-line">@localizer["AllowedNames"] @Model.PlayerAllowedNames</div>
                }
                <div class="clue">
                    <span class="tag">@localizer["DayClue"]</span>
                    <p>@Html.Raw(Model.Clue)</p>
                </div>
                <div class="clue">
                    <span class="tag">@localizer["EasyDayClue"]</span>
                    <p>@Html.Raw(Model.EasyClue)</p>
                </div>
            </div>
            <div class="rows">
                <div class="dossier-row solved">
                    <div class="field">@localizer["FinalPosition"]</div>
                    <div class="value">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @Model.Position
                    </div>
                </div>
                <div class="dossier-row solved">
                    <div class="field">@localizer["FinalBirthYear"]</div>
                    <div class="value">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @Model.BirthYear
                    </div>
                </div>
                <div class="dossier-row solved">
                    <div class="field">@localizer["FinalContinent"]</div>
                    <div class="value">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @Model.ContinentName
                    </div>
                </div>
                <div class="dossier-row solved">
                    <div class="field">@localizer["FinalNationality"]</div>
                    <div class="value">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @Model.CountryName
                    </div>
                </div>
                <div class="dossier-row solved">
                    <div class="field">@localizer["FinalClubs"]</div>
                    <div class="club-list">
                        @foreach (var club in Model.KnownPlayerClubs.OrderBy(x => x.HistoryPosition))
                        {
                            <div class="club">
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                @club.HistoryPosition &mdash; @club.Name
                                @if (club.IsLoan)
                                {
                                    <span class="loan">@localizer["LoanInitial"]</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(Model.MessageToDisplay) && !Model.IsErrorMessageForced)
            {
                <div class="banner @(Model.IsErrorMessage ? "error" : "success")">@Model.MessageToDisplay</div>
            }
            <div class="dossier-head">
                <div class="clue">
                    <span class="tag">@localizer["DayClue"]</span>
                    <p>@Html.Raw(Model.Clue)</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.EasyClue))
                {
                    <div class="clue">
                        <span class="tag">@localizer["EasyDayClue"]</span>
                        <p>@Html.Raw(Model.EasyClue)</p>
                    </div>
                }
            </div>
            await Html.RenderPartialAsync("Partial/Badges", Model.Badges);
            <div class="rows" style="padding-top:18px">
                <div class="actions">
                    @if (string.IsNullOrWhiteSpace(Model.EasyClue))
                    {
                        <form method="post" action="/" style="margin:0">
                            @Html.HiddenFor(m => m.CurrentDay)
                            <button type="submit" name="submit-Clue">@localizer["NeedAnotherClue"] <span class="cost">-@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Clue].points% @localizer["PointsPercent"]</span></button>
                        </form>
                    }
                    @if (Model.CurrentDay > 0)
                    {
                        <form method="post" action="/" style="margin:0">
                            @Html.HiddenFor(m => m.CurrentDay)
                            <button type="submit" onclick="return confirm('@localizer["GiveUpConfirmation"]')" name="submit-GiveUp">@localizer["GiveUp"] <span class="cost">@localizer["NoPoints"]</span></button>
                        </form>
                    }
                    else if (!Model.LeaderboardAvailable)
                    {
                        <form method="post" action="/" style="margin:0">
                            @Html.HiddenFor(m => m.CurrentDay)
                            <button type="submit" name="submit-Leaderboard">@localizer["LeaderboardAccess"] <span class="cost">-@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Leaderboard].points @localizer["Points"]</span></button>
                        </form>
                    }
                </div>
            </div>
            <div class="rows">
                <!-- clubs -->
                <form method="post" action="/" class="dossier-row locked">
                    @Html.HiddenFor(m => m.CurrentDay)
                    <div class="field">@localizer["ClubsTitle"]<span class="hint">@localizer["ClubTipOne"]</span></div>
                    <div>
                        @if (Model.KnownPlayerClubs?.Count > 0)
                        {
                            <div class="club-list">
                                @foreach (var club in Model.KnownPlayerClubs)
                                {
                                    <div class="club">
                                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                        @club.HistoryPosition &mdash; @club.Name
                                        @if (club.IsLoan)
                                        {
                                            <span class="loan">@localizer["LoanInitial"]</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <div class="blank-wrap">
                            <input type="text" name="ClubNameSubmissionValue" id="clubName" class="blank" placeholder="Real Madrid, PSG…" />
                            <input type="hidden" name="ClubIdSubmission" id="clubId" />
                            <input type="submit" value="Ok" name="submit-Club" id="submitClub" style="visibility:hidden; width: 0px" />
                        </div>
                        @if (Model.IncorrectClubs?.Count > 0)
                        {
                            <div class="attempts">
                                @foreach (var iClub in Model.IncorrectClubs)
                                {
                                    <div class="attempt"><s>@iClub</s></div>
                                }
                            </div>
                        }
                        @if (Model.CanCreateClub)
                        {
                            <div class="small-link"><a href="/Admin/Club" target="_blank">@localizer["HelpToCreateClub"]</a> (@localizer["NewTab"])</div>
                        }
                    </div>
                    <div class="cost">-@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Club].points pts</div>
                </form>
                <!-- continent -->
                <form method="post" action="/" class="dossier-row @(string.IsNullOrWhiteSpace(Model.ContinentName) ? "locked" : "solved")">
                    @Html.HiddenFor(m => m.CurrentDay)
                    <div class="field">@localizer["ContinentTitle"]</div>
                    @if (string.IsNullOrWhiteSpace(Model.ContinentName))
                    {
                        <div>
                            <div class="blank-wrap">
                                <input type="text" id="continentName" name="ContinentNameSubmissionValue" class="blank" placeholder="Europe, Amérique du Sud…" />
                                <input type="hidden" id="continentId" name="ContinentNameSubmission" />
                                <input type="submit" value="Ok" id="submitContinent" name="submit-Continent" style="visibility: hidden; width: 0px" />
                            </div>
                            @if (Model.IncorrectContinents?.Count > 0)
                            {
                                <div class="attempts">
                                    @foreach (var iContinent in Model.IncorrectContinents)
                                    {
                                        <div class="attempt"><s>@iContinent</s></div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="cost">-@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Continent].points pts</div>
                    }
                    else
                    {
                        <div class="value">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            @Model.ContinentName
                        </div>
                    }
                </form>
            <!-- nationality -->
            <form method="post" action="/" class="dossier-row @(string.IsNullOrWhiteSpace(Model.CountryName) ? "locked" : "solved")">
                @Html.HiddenFor(m => m.CurrentDay)
                <div class="field">@localizer["NationalityTitle"]<span class="hint">@Html.Raw(localizer["TipAboutNationality"].Value)</span></div>
                @if (string.IsNullOrWhiteSpace(Model.CountryName))
                {
                    <div>
                        <div class="blank-wrap">
                            <input type="text" id="countryName" name="CountryNameSubmissionValue" class="blank" placeholder="France, Brésil…" />
                            <input type="hidden" id="countryId" name="CountryNameSubmission" />
                            <input type="submit" value="Ok" id="submitCountry" name="submit-Country" style="visibility: hidden; width: 0px" />
                        </div>
                        @if (Model.IncorrectCountries?.Count > 0)
                        {
                            <div class="attempts">
                                @foreach (var iCountry in Model.IncorrectCountries)
                                {
                                    <div class="attempt"><s>@iCountry</s></div>
                                }
                            </div>
                        }
                    </div>
                    <div class="cost">-@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Country].points pts</div>
                }
                else
                {
                    <div class="value">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @Model.CountryName
                    </div>
                }
            </form>
            <!-- year -->
            <form method="post" action="/" class="dossier-row @(string.IsNullOrWhiteSpace(Model.BirthYear) ? "locked" : "solved")">
                @Html.HiddenFor(m => m.CurrentDay)
                <div class="field">@localizer["BirthYearTitle"]</div>
                @if (string.IsNullOrWhiteSpace(Model.BirthYear))
                {
                    <div>
                        <div class="blank-wrap" style="max-width:110px">
                            <input type="text" id="birthYearValue" name="BirthYearSubmission" class="blank" placeholder="1998" />
                            <input type="submit" value="Ok" id="submitYear" name="submit-Year" style="visibility:hidden; width: 0px" />
                        </div>
                        @if (Model.IncorrectYears?.Count > 0)
                        {
                            <div class="attempts">
                                @foreach (var (iYear, iTip) in Model.IncorrectYears)
                                {
                                    <div class="attempt"><s>@iYear</s><span class="tag">@iTip</span></div>
                                }
                            </div>
                        }
                    </div>
                    <div class="cost">-@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Year].points pts</div>
                }
                else
                {
                    <div class="value">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @Model.BirthYear
                    </div>
                }
            </form>
            <!-- position -->
            <form method="post" action="/" class="dossier-row @(string.IsNullOrWhiteSpace(Model.Position) ? "locked" : "solved")">
                @Html.HiddenFor(m => m.CurrentDay)
                <div class="field">@localizer["PositionTitle"]<span class="hint">@localizer["TipAboutPosition"]</span></div>
                @if (string.IsNullOrWhiteSpace(Model.Position))
                {
                    <div>
                        @if (Model.IncorrectPositions?.Count > 0)
                        {
                            <div class="attempts">
                                @foreach (var iPosition in Model.IncorrectPositions)
                                {
                                    <div class="attempt"><s>@iPosition</s></div>
                                }
                            </div>
                        }
                        @Html.DropDownListFor(m => m.PositionSubmission, Model.Positions, new { @class = "blank", @id = "positionSubmission" })
                        <input type="submit" value="Ok" id="submitPosition" name="submit-Position" style="visibility:hidden; width: 0px" />
                    </div>
                    <div class="cost">-@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Position].points pts</div>
                }
                else
                {
                    <div>
                        @if (Model.IncorrectPositions?.Count > 0)
                        {
                            <div class="attempts">
                                @foreach (var iPosition in Model.IncorrectPositions)
                                {
                                    <div class="attempt"><s>@iPosition</s></div>
                                }
                            </div>
                        }
                        <div class="value">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7.5L5.5 11L12 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            @Model.Position
                        </div>
                    </div>
                }
            </form>
            </div>
            <div class="final">
                <div class="field">@localizer["TypePlayerName"]</div>
                <form method="post" action="/" style="margin:0">
                    @Html.HiddenFor(m => m.CurrentDay)
                    <div class="final-input">
                        <input type="text" name="PlayerNameSubmission" value="@Model.PlayerNameSubmission" placeholder="Zinédine Zidane, Kylian Mbappé…" />
                        <button type="submit" name="submit-Name">Valider</button>
                    </div>
                </form>
                @if (Model.IncorrectNames?.Count > 0)
                {
                    <div class="attempts">
                        @foreach (var iName in Model.IncorrectNames)
                        {
                            <div class="attempt"><s>@iName</s></div>
                        }
                    </div>
                }
                <p class="caption">-<strong>@KikoleSite.Models.ScoreCalculator.ProposalTypesCost[KikoleSite.Models.Enums.ProposalTypes.Name].points @localizer["PointsIfIncorrect"]</strong></p>
            </div>
        }
        </div>
        <hr />
        await Html.RenderPartialAsync("Partial/Rules");
    }
</div>