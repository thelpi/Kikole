@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model ContactModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="banner error">@Model.ErrorMessage</div>
    }
    <div class="form-card">
        <h3>@localizer["ContactAdmin"]</h3>
        @{
            var threadModel = new DiscussionThreadModel
            {
                Messages = Model.Messages,
                ViewerIsAdmin = false,
                SelfLabel = localizer["FromYou"].Value,
                OtherLabel = localizer["FromAdmin"].Value,
                NoMessagesText = localizer["NoMessagesYet"].Value
            };
        }
        @await Html.PartialAsync("Partial/DiscussionThread", threadModel)
        <form method="post" action="/Home/Contact">
            <div class="form-field">
                <label>@localizer["YourMessage"]</label>
                @Html.TextAreaFor(m => m.NewMessage, new { @class = "blank" })
            </div>
            <div class="actions">
                <button type="submit">@localizer["ToSend"]</button>
            </div>
        </form>
    </div>
</div>
