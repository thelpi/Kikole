@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model ContactModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="banner error">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="banner success">@Model.SuccessMessage</div>
    }
    <div class="form-card">
        <h3>@localizer["ContactAdmin"]</h3>
        <form method="post" action="/Home/Contact">
            <div class="form-field">
                <label>@localizer["YourEmail"]</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "blank" })
            </div>
            <div class="form-field">
                <label>@localizer["YourMessage"]</label>
                @Html.TextAreaFor(m => m.Message, new { @class = "blank" })
            </div>
            <div class="actions">
                <button type="submit">@localizer["ToSend"]</button>
            </div>
        </form>
    </div>
</div>
