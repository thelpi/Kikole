@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@inject Microsoft.Extensions.Options.IOptions<KikoleSite.Configuration.SeoOptions> seoOptions
@model HomeModel
@{
    var streak = Model.Streak?.Current ?? 0;
    var text = streak >= 2
        ? string.Format(localizer["ShareTextWithStreak"].Value, Model.Points, streak)
        : string.Format(localizer["ShareText"].Value, Model.Points);
    var url = seoOptions.Value.CanonicalBaseUrl.TrimEnd('/') + "/";
}
<div class="share">
    <button type="button" class="share-btn" data-share-text="@text" data-share-url="@url" data-copied-label="@localizer["Copied"]">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
            <path d="M8.6 10.6 15.4 6.4" /><path d="M8.6 13.4 15.4 17.6" />
        </svg>
        @localizer["ShareResult"]
    </button>
    <span class="share-feedback" role="status" aria-live="polite"></span>
</div>