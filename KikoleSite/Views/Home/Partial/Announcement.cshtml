@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model KikoleSite.ViewModels.HomeModel
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="banner info announcement" data-message-id="@Model.MessageId">
        <div class="announcement-head">
            <svg class="announcement-icon" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3" />
                <circle cx="8" cy="5.1" r="0.9" fill="currentColor" />
                <path d="M8 7.4V11.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
            </svg>
            <span class="announcement-label">@localizer["AnnouncementLabel"]</span>
            <button type="button" class="announcement-toggle" aria-expanded="true" aria-label="@localizer["ToggleAnnouncement"]" title="@localizer["ToggleAnnouncement"]">
                <svg class="announcement-chevron" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <button type="button" class="announcement-dismiss" aria-label="@localizer["DismissAnnouncement"]" title="@localizer["DismissAnnouncement"]">&times;</button>
        </div>
        <div class="announcement-body">@Html.Raw(Model.Message)</div>
    </div>
}
