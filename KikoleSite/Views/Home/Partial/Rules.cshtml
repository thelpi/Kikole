@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using KikoleSite.Models;
@using KikoleSite.Models.Enums;
<div class="form-card">
    @localizer["Rules"]
    <p>@localizer["ScoreIntro"]</p>
    <ul>
        <li>@Html.Raw(string.Format(localizer["StarterPoints"].Value, ScoreCalculator.BasePoints))</li>
        <li>@Html.Raw(string.Format(localizer["BadGuessName"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Name].points))</li>
        <li>@Html.Raw(string.Format(localizer["BadGuessClub"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Club].points))</li>
        <li>@Html.Raw(string.Format(localizer["BadGuessContinent"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Continent].points))</li>
        <li>@Html.Raw(string.Format(localizer["BadGuessCountry"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Country].points))</li>
        <li>@Html.Raw(string.Format(localizer["BadGuessYear"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Year].points))</li>
        <li>@Html.Raw(string.Format(localizer["BadGuessPosition"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Position].points))</li>
        <li>@Html.Raw(string.Format(localizer["ClueGuess"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Clue].points))</li>
        <li>@Html.Raw(string.Format(localizer["GetLeaderboard"].Value, ScoreCalculator.ProposalTypesCost[ProposalTypes.Leaderboard].points))</li>
        <li>@localizer["GoodGuess"]</li>
        <li>@Html.Raw(string.Format(localizer["SubmissionPoints"].Value, ScoreCalculator.SubmissionPoints))</li>
    </ul>
    <h3 id="country-rules">@localizer["AboutCountry"]</h3>
    @localizer["AboutCountryDetails"]
    <h3 id="clubs-rules">@localizer["AboutClubs"]</h3>
    @localizer["AboutClubsDetails"]
</div>
