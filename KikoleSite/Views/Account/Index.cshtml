@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model AccountModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="banner error">@Model.Error</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.SuccessInfo))
    {
        <div class="banner success">@Model.SuccessInfo</div>
    }

    @if (Model.IsAuthenticated)
    {
        <div class="form-card">
            <h3>@localizer["LogOut"]</h3>
            <form method="post" action="/Account">
                <div class="form-field">
                    <label>@localizer["LoggedAs"]</label>
                    <div class="form-static">@Model.Login</div>
                </div>
                <div class="actions">
                    <button type="submit" name="submit-logoff">@localizer["LogOut"]</button>
                </div>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["ChangePassword"]</h3>
            <form method="post" action="/Account">
                <div class="form-field">
                    <label>@localizer["CurrentPwd"]</label>
                    @Html.PasswordFor(m => m.PasswordSubmission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["NewPwd"]</label>
                    @Html.PasswordFor(m => m.PasswordCreate1Submission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["RepeatPwd"]</label>
                    @Html.PasswordFor(m => m.PasswordCreate2Submission, new { @class = "blank" })
                </div>
                <div class="actions">
                    <button type="submit" name="submit-changepassword">@localizer["Update"]</button>
                </div>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["ChangeQAndA"]</h3>
            <form method="post" action="/Account">
                <div class="form-field">
                    <label>@localizer["RecQuestion"]</label>
                    @Html.TextBoxFor(m => m.RecoveryQCreate, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["RecAnswer"]</label>
                    @Html.PasswordFor(m => m.RecoveryACreate, new { @class = "blank" })
                </div>
                <div class="actions">
                    <button type="submit" name="submit-resetqanda">@localizer["Update"]</button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="form-card">
            <h3>@localizer["LogIn"]</h3>
            <form method="post" action="/Account">
                <div class="form-field">
                    <label>@localizer["SetLogin"]</label>
                    @Html.TextBoxFor(m => m.LoginSubmission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["SetPwd"]</label>
                    @Html.PasswordFor(m => m.PasswordSubmission, new { @class = "blank" })
                </div>
                <div class="actions">
                    <button type="submit" name="submit-login">@localizer["LogIn"]</button>
                </div>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["CreateAccount"]</h3>
            <form method="post" action="/Account">
                @if (Model.RegistrationInviteEnabled)
                {
                    <p class="form-hint"><a href="/Home/Contest">@localizer["FreeRegistrationClosed"]</a></p>
                    <div class="form-field">
                        <label>@localizer["SetRegistrationId"]</label>
                        @Html.TextBoxFor(m => m.RegistrationId, new { @class = "blank" })
                    </div>
                    <p class="form-hint">@localizer["TipRegistrationId"]</p>
                }
                <div class="form-field">
                    <label>@localizer["SetLogin"]</label>
                    @Html.TextBoxFor(m => m.LoginCreateSubmission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["SetPwd"]</label>
                    @Html.PasswordFor(m => m.PasswordCreate1Submission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["RepeatPwd"]</label>
                    @Html.PasswordFor(m => m.PasswordCreate2Submission, new { @class = "blank" })
                </div>
                <p class="form-hint">@localizer["TipRecovery"]</p>
                <div class="form-field">
                    <label>@localizer["RecQuestion"]</label>
                    @Html.TextBoxFor(m => m.RecoveryQCreate, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["RecAnswer"]</label>
                    @Html.PasswordFor(m => m.RecoveryACreate, new { @class = "blank" })
                </div>
                <div class="actions">
                    <button type="submit" name="submit-create">@localizer["Create"]</button>
                </div>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["GetPwdByQuestion"]</h3>
            <form method="post" action="/Account">
                @if (string.IsNullOrWhiteSpace(Model.QuestionRecovery))
                {
                    <div class="form-field">
                        <label>@localizer["LoginRecover"]</label>
                        @Html.TextBoxFor(m => m.LoginRecoverySubmission, new { @class = "blank" })
                    </div>
                    @* soumission volontairement invisible : cette premiere etape ne se
                       valide qu'a la touche Entree, pas via un bouton visible. *@
                    <button type="submit" name="submit-getloginquestion" style="visibility: hidden">@localizer["Update"]</button>
                }
                else
                {
                    <div class="form-field">
                        <label>@localizer["LoginRecover"]</label>
                        <div class="form-static">@Model.LoginRecoverySubmission</div>
                        @Html.HiddenFor(m => m.LoginRecoverySubmission)
                    </div>
                    <div class="form-field">
                        <label>@localizer["RecQuestion"]</label>
                        <div class="form-static">@Model.QuestionRecovery</div>
                    </div>
                    <div class="form-field">
                        <label>@localizer["RecAnswer"]</label>
                        @Html.PasswordFor(m => m.RecoveryACreate, new { @class = "blank" })
                    </div>
                    <div class="form-field">
                        <label>@localizer["NewPwd"]</label>
                        @Html.PasswordFor(m => m.PasswordCreate1Submission, new { @class = "blank" })
                    </div>
                    <div class="form-field">
                        <label>@localizer["RepeatPwd"]</label>
                        @Html.PasswordFor(m => m.PasswordCreate2Submission, new { @class = "blank" })
                    </div>
                    <div class="actions">
                        <button type="submit" name="submit-resetpassword">@localizer["Update"]</button>
                    </div>
                }
            </form>
        </div>
    }
</div>
