@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model AccountModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="banner error">@Model.Error</div>
    }
    else if (!string.IsNullOrWhiteSpace(Model.SuccessInfo))
    {
        <div class="banner success">@Model.SuccessInfo</div>
    }

    @if (Model.IsAuthenticated)
    {
        <div class="form-card">
            <h3>@localizer["LogOut"]</h3>
            <form method="post" action="/Account/LogOut">
                <div class="form-field">
                    <label>@localizer["LoggedAs"]</label>
                    <div class="form-static accent">@Model.Login</div>
                </div>
                <div class="form-field">
                    <label>@localizer["CurrentEmail"]</label>
                    <div class="form-static">@Model.Email</div>
                </div>
                <div class="actions">
                    <button type="submit">@localizer["LogOut"]</button>
                </div>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["ChangePassword"]</h3>
            <form method="post" action="/Account/ChangePassword">
                <div class="form-field">
                    <label>@localizer["CurrentPwd"]</label>
                    <div class="password-wrap">
                        @Html.PasswordFor(m => m.PasswordSubmission, new { @class = "blank" })
                        <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                                <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="form-field">
                    <label>@localizer["NewPwd"]</label>
                    <div class="password-wrap">
                        @Html.PasswordFor(m => m.PasswordCreate1Submission, new { @class = "blank" })
                        <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                                <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="form-field">
                    <label>@localizer["RepeatPwd"]</label>
                    <div class="password-wrap">
                        @Html.PasswordFor(m => m.PasswordCreate2Submission, new { @class = "blank" })
                        <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                                <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="actions">
                    <button type="submit">@localizer["Update"]</button>
                </div>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["ChangeEmail"]</h3>
            <form method="post" action="/Account/ChangeEmail">
                <div class="form-field">
                    <label>@localizer["CurrentPwd"]</label>
                    <div class="password-wrap">
                        @Html.PasswordFor(m => m.PasswordSubmission, new { @class = "blank" })
                        <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                                <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="form-field">
                    <label>@localizer["NewEmail"]</label>
                    @Html.TextBoxFor(m => m.NewEmailSubmission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["ConfirmNewEmail"]</label>
                    @Html.TextBoxFor(m => m.NewEmailConfirmSubmission, new { @class = "blank" })
                </div>
                <div class="actions">
                    <button type="submit">@localizer["Update"]</button>
                </div>
            </form>
        </div>

        @if (Model.HasSponsorshipInfo)
        {
            <div class="form-card">
                <h3>@localizer["Sponsorship"]</h3>
                @if (!string.IsNullOrWhiteSpace(Model.SponsorLogin))
                {
                    <div class="form-field">
                        <label>@localizer["YourSponsor"]</label>
                        <div class="form-static">@Model.SponsorLogin</div>
                    </div>
                }
                @if (Model.Godchildren.Count > 0)
                {
                    <div class="form-field">
                        <label>@localizer["YourGodchildren"]</label>
                        <div class="form-static">
                            @foreach (var godchild in Model.Godchildren)
                            {
                                @if (godchild.IsDisabled)
                                {
                                    <div><s>@godchild.Login</s></div>
                                }
                                else
                                {
                                    <div>@godchild.Login</div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="form-card">
            <h3>@localizer["LogInTitle"]</h3>
            <form method="post" action="/Account/LogIn">
                <div class="form-field">
                    <label>@localizer["LoginOrEmail"]</label>
                    @Html.TextBoxFor(m => m.LoginSubmission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["SetPwd"]</label>
                    <div class="password-wrap">
                        @Html.PasswordFor(m => m.PasswordSubmission, new { @class = "blank" })
                        <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                                <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="actions">
                    <button type="submit">@localizer["LogIn"]</button>
                    <button type="submit" class="secondary" formaction="/Account/ResendConfirmation">@localizer["ResendConfirmation"]</button>
                </div>
                <p class="hint">@localizer["ResendConfirmationHint"]</p>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["CreateAccount"]</h3>
            <form method="post" action="/Account/Create">
                @if (Model.RegistrationInviteEnabled)
                {
                    <p class="form-hint">@localizer["FreeRegistrationClosed"]</p>
                    <div class="form-field">
                        <label>@localizer["SetRegistrationId"]</label>
                        @Html.TextBoxFor(m => m.RegistrationId, new { @class = "blank" })
                    </div>
                    <p class="form-hint">@localizer["TipRegistrationId"]</p>
                }
                <div class="form-field">
                    <label>@localizer["SetLogin"]</label>
                    @Html.TextBoxFor(m => m.LoginCreateSubmission, new { @class = "blank" })
                </div>
                <div class="form-field">
                    <label>@localizer["SetEmail"]</label>
                    @Html.TextBoxFor(m => m.EmailCreateSubmission, new { @class = "blank", type = "email" })
                </div>
                <div class="form-field">
                    <label>@localizer["SetPwd"]</label>
                    <div class="password-wrap">
                        @Html.PasswordFor(m => m.PasswordCreate1Submission, new { @class = "blank" })
                        <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                                <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="form-field">
                    <label>@localizer["RepeatPwd"]</label>
                    <div class="password-wrap">
                        @Html.PasswordFor(m => m.PasswordCreate2Submission, new { @class = "blank" })
                        <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                            <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                                <circle cx="12" cy="12" r="3" />
                                <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                            </svg>
                        </button>
                    </div>
                </div>
                @if (Model.SponsorshipEnabled)
                {
                    <div class="form-field">
                        <label>@localizer["SponsorLogin"]</label>
                        @Html.TextBoxFor(m => m.SponsorLoginSubmission, new { @class = "blank" })
                    </div>
                }
                <p class="hint">@localizer["PrivacyNotice"]</p>
                <div class="actions">
                    <button type="submit">@localizer["Create"]</button>
                </div>
            </form>
        </div>

        <div class="form-card">
            <h3>@localizer["ForgotPassword"]</h3>
            <form method="post" action="/Account/RequestPasswordReset">
                <div class="form-field">
                    <label>@localizer["EmailToRecover"]</label>
                    @Html.TextBoxFor(m => m.PasswordResetEmailSubmission, new { @class = "blank", type = "email" })
                </div>
                <div class="actions">
                    <button type="submit">@localizer["Update"]</button>
                </div>
            </form>
        </div>
    }
</div>
