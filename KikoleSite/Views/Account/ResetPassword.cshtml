@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@model AccountModel

<div class="kikole-board">
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="banner error">@Model.Error</div>
    }

    <div class="form-card">
        <h3>@localizer["ResetPasswordTitle"]</h3>
        <form method="post" action="/Account/ResetPassword">
            @Html.HiddenFor(m => m.ResetPasswordUserId)
            @Html.HiddenFor(m => m.ResetPasswordToken)
            <div class="form-field">
                <label>@localizer["NewPwd"]</label>
                <div class="password-wrap">
                    @Html.PasswordFor(m => m.PasswordCreate1Submission, new { @class = "blank" })
                    <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                        <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                            <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="form-field">
                <label>@localizer["RepeatPwd"]</label>
                <div class="password-wrap">
                    @Html.PasswordFor(m => m.PasswordCreate2Submission, new { @class = "blank" })
                    <button type="button" class="password-toggle" aria-label="@localizer["ShowPassword"]">
                        <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z" />
                            <circle cx="12" cy="12" r="3" />
                            <line class="icon-eye-slash" x1="3" y1="3" x2="21" y2="21" />
                        </svg>
                    </button>
                </div>
            </div>
            <div class="actions">
                <button type="submit">@localizer["Update"]</button>
            </div>
        </form>
    </div>
</div>
